{
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "installCommand": "",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(images|img|videos|og)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }]
    },
    {
      "source": "/assets/vendor/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(styles.css|main.js)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    }
  ],
  "redirects": [
    {
      "source": "/servicos/criativos-redes-sociais",
      "destination": "/#servicos",
      "permanent": true
    },
    {
      "source": "/servicos/edicao-de-video",
      "destination": "/#servicos",
      "permanent": true
    },
    {
      "source": "/servicos/criativos-anuncios",
      "destination": "/#servicos",
      "permanent": true
    }
  ]
}
